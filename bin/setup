#!/usr/bin/env bash
# Fresh clone → ready to run bin/check. Idempotent; safe to re-run after every pull.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

ok() { printf '\033[0;32m✔\033[0m  %s\n' "$*"; }
die() { printf '\033[0;31m✘\033[0m  %s\n' "$*" >&2; exit 1; }

command -v rustup >/dev/null || die "rustup not found — install from https://rustup.rs"
command -v git >/dev/null || die "git not found"
command -v jq >/dev/null || echo "!  jq not found — the Claude Code rustfmt hook (.claude/hooks/fmt-rust.sh) will be a no-op"

rustup show active-toolchain >/dev/null   # installs the toolchain rustup selects

# The toolchain that answers has to be the pinned one. A shim earlier on PATH
# (mise, asdf, …) can pin another Rust, and RUSTUP_TOOLCHAIN in the environment
# overrides rust-toolchain.toml itself, so rustup's own answer is not enough:
# put the pinned toolchain's bin directory first on PATH, then check the
# toolchain that answers is that one and dies loudly if it is not.
pinned=""
components=""
if [[ -f rust-toolchain.toml ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*channel[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
      pinned="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ^[[:space:]]*components[[:space:]]*=[[:space:]]*\[([^]]*)\] ]]; then
      components="${BASH_REMATCH[1]//\"/}"
      components="${components//,/ }"
    fi
  done < rust-toolchain.toml
fi

pinned_rustc=""
if [[ -n "$pinned" ]]; then
  if ! pinned_rustc="$(rustup which --toolchain "$pinned" rustc 2>/dev/null)"; then
    install_args=(toolchain install "$pinned" --profile minimal)
    for component in $components; do install_args+=(--component "$component"); done
    rustup "${install_args[@]}"
    pinned_rustc="$(rustup which --toolchain "$pinned" rustc)"
  fi
  if [[ -n "$components" ]]; then
    add_args=()
    for component in $components; do add_args+=("$component"); done
    rustup component add --toolchain "$pinned" "${add_args[@]}"
  fi
  export PATH="$(dirname "$pinned_rustc"):$PATH"
fi

rustc_version="$(rustc --version)"
if [[ -n "$pinned" ]]; then
  if [[ "$(command -v rustc)" != "$pinned_rustc" ]]; then
    die "rustc resolves to $(command -v rustc), not the pinned $pinned ($pinned_rustc) — a shim earlier on PATH is overriding it"
  fi
  pinned_version="${pinned%%-*}"   # 1.98.0 out of 1.98.0-x86_64-unknown-linux-gnu
  case "$pinned_version" in
    [0-9]*)
      if [[ "$rustc_version" != "rustc $pinned_version"* ]]; then
        die "rustc answers '$rustc_version', but rust-toolchain.toml pins $pinned"
      fi
      ;;
  esac
fi
ok "toolchain $rustc_version"
if [[ -n "$pinned" ]]; then
  printf '   export PATH=%s:$PATH   # keep the pinned toolchain in this shell\n' "$(dirname "$pinned_rustc")"
fi

git config core.symlinks true             # AGENTS.md -> CLAUDE.md
mkdir -p tmp
cargo fetch --quiet --locked
cargo build --quiet --workspace --locked
ok "workspace builds"

# The dependency advisory scanner bin/check needs (see deny.toml). Pinned, so
# every box reads the same rule set. cargo skips an already-installed EXACT
# version; a DIFFERENT version sitting in the install root has to be replaced,
# and cargo refuses that without --force.
CARGO_DENY_VERSION=0.20.2
cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
installed="$("$cargo_bin/cargo-deny" --version 2>/dev/null | awk '{print $2}' || true)"
if [ "$installed" = "$CARGO_DENY_VERSION" ]; then
  ok "cargo-deny $CARGO_DENY_VERSION"
else
  cargo install --locked cargo-deny --version "$CARGO_DENY_VERSION" --force \
    || die "cargo-deny $CARGO_DENY_VERSION install failed — bin/check runs it, so a clone without it is not ready"
  ok "cargo-deny $CARGO_DENY_VERSION"
fi

# Another cargo-deny earlier on PATH would shadow the pinned one; say so rather
# than let the gate fail later on a version the maintainer did not choose.
on_path="$(cargo deny --version 2>/dev/null | awk '{print $2}' || true)"
[ "$on_path" = "$CARGO_DENY_VERSION" ] \
  || echo "!  cargo deny on PATH is ${on_path:-not found}, pinned is $CARGO_DENY_VERSION ($cargo_bin/cargo-deny)"

ok "Next: bin/check"
