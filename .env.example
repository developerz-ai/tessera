# Bearer token for the developerz MCP server (.mcp.json mcpServers.developerz.headers.Authorization).
DEVELOPERZ_API_KEY=your-developerz-api-key-here
# Auth token for @sentry/mcp-server (.mcp.json mcpServers.sentry-mcp env).
SENTRY_ACCESS_TOKEN=your-sentry-access-token-here
# Sentry hostname for @sentry/mcp-server (.mcp.json mcpServers.sentry-mcp env).
SENTRY_HOST=sentry.example.com
