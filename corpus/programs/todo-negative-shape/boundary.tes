module todo_negative_shape @1;

type Status = Open | Done(at: Instant);
type Task = { id: Id<Task>, owner: Id<User>, title: Text, status: Status, created: Instant };
type User = { id: Id<User>, name: Text };

state tasks: Table<Task> key id;
state users: Table<User> key id;

needs clock: Clock;

fixture bob: Id<User> = #1 : Id<User>;
fixture alice_task: Id<Task> = #12 : Id<Task>;

// `Id<Task>` and `Id<User>` are distinct nominal types (§3), so this law never
// compares the two domains: `t.owner` and `u.id` are both `Id<User>`.
law owner_is_named_user: forall t in tasks. forall u in users. (t.owner == u.id) => (u.name != "");

// Mirror #10 edge — no id domain crosses into another. The fixtures above are
// `Id<User>` and `Id<Task>`; the law compares `t.owner` (an `Id<User>`) with
// `u.id` (also an `Id<User>`), never an `Id<Task>` against an `Id<User>` value.

example tag(bob, alice_task) fails NotFound;

rule tag(by: Id<User>, of: Id<Task>) {
  let t = tasks[of] or fail NotFound;
  require t.owner == by or fail NotFound;
  let u = users[by] or fail NotFound;
  tasks[of].title = "tagged by " + u.name;
}
