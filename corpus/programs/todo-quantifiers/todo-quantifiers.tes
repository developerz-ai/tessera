module todo_quantifiers @1;
// law bodies: a conjunction and an implication over one quantifier
type Task = { id: Id<Task>, count: Int, total: Int };
state tasks: Table<Task> key id;
rule bump(id: Id<Task>) {
  let t = tasks[id] or fail NotFound;
  tasks[id].total = t.total + 1;
}
law counts_below_total: forall t in tasks. (t.count <= t.total) && (t.total >= t.count);
law implied_bound: forall t in tasks. (t.count <= t.total) => (t.total >= t.count);
fixture task_12: Id<Task> = #12 : Id<Task>;
example bump(task_12) fails NotFound;
