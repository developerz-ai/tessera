module todo_ascribe_boundary @1;

type Status = Open | Done(at: Instant);
type Task = { id: Id<Task>, owner: Id<User>, title: Text, status: Status, created: Instant };
type User = { id: Id<User>, name: Text };

state tasks: Table<Task> key id;
state users: Table<User> key id;

needs clock: Clock;

fixture bob: Id<User> = #1 : Id<User>;
fixture alice_task: Id<Task> = #12 : Id<Task>;
fixture opened_on: Date = 2026-10-22;

rule complete(by: Id<User>, id: Id<Task>, on: Date) needs clock {
  let t = tasks[id] or fail NotFound;
  require t.owner == by or fail NotFound;
  require on >= opened_on or fail Stale;
  tasks[id].status = Done(clock.now) unless t.status is Done;
}

law ascribed_only_same: forall t in tasks. (t.id == alice_task) => (t.status is Done);

// Ascription on both sides of the boundary: an `Id<Task>` literal and a
// `Date`-typed fixture value. #10 ascription side.
example complete(bob, alice_task, opened_on) fails NotFound;
