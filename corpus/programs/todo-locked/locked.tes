module todo_locked @1;

type Status = Open | Done(at: Instant);
type Task = { id: Id<Task>, owner: Id<User>, title: Text, status: Status, created: Date };
type User = { id: Id<User>, name: Text, locked: Bool };

state tasks: Table<Task> key id;
state users: Table<User> key id;

needs clock: Clock;

fixture bob: Id<User> = #1 : Id<User>;
fixture alice_task: Id<Task> = #12 : Id<Task>;

rule complete(by: Id<User>, id: Id<Task>) needs clock {
  let u = users[by] or fail NotFound;
  let t = tasks[id] or fail NotFound;
  require u.locked == false or fail Forbidden;
  require t.owner == by or fail NotFound;
  let finished = t.status is Done || (t.created >= 2026-10-22) or fail SortOrder;
  tasks[id].status = Done(clock.now) unless t.status is Done;
  return finished;
}

law complete_locks_owner: forall t in tasks. (t.status is Done) => (t.owner in users) with (users[t.owner].locked == false);

example complete(bob, alice_task) fails NotFound;
